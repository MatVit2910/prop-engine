# Database Settings (TimescaleDB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nba_props_db
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=quant_password

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379

# API Keys (Optional - Engine defaults to built-in simulation stream if blank)
THE_ODDS_API_KEY=your_the_odds_api_key_here
SPORTRADAR_API_KEY=your_sportradar_api_key_here

# Risk & Trading Parameters
MIN_EV_THRESHOLD=0.03
MIN_EDGE_OVER_CONSENSUS=0.015
KELLY_FRACTION=0.125
MAX_WAGER_CAP=500.00
BANKROLL_AMOUNT=10000.00

# Optional Webhook Notifications (Discord / Telegram / JSON Webhook)
WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url
